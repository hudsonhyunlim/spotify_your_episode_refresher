    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {},
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.10.2",
    "eslint": "^9.17.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.20.0"
  }
}
